{
  "version": 2,
  "public": "client/dist",
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/user/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/ride/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
 "version": 2,
 "builds": [
  {
   "src": "index.js",
   "use": "@vercel/node"
  }
 ],
"routes": [
    {
      "src": "^/(user|ride)(/.*)?$",
      "dest": "server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ]
}
